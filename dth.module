#!name=👑 Locket Gold All-In-One (dth206)
#!desc=Module Locket Gold VIP hoàn hảo nhất bởi dth206 | Đồng bộ kiến trúc Phú Bôn 1.4.1 + Mở khóa Gold Vĩnh Viễn + Bộ Lọc Biến Hình & AI Camera chuẩn 100% + Video 60s + 217+ Captions VIP + Gửi Riêng Mình (Chỉ mình tôi) + Chặn QC & Tracking
#!author=dth206
#!homepage=https://github.com/dth20006/shadow

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del If-None-Match

[Script]
# 1. Mở khóa Locket Gold VIP Vĩnh Viễn (RevenueCat)
dth_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_gold.js?v=7.0, requires-body=true, max-size=-1, timeout=10

# 2. Xóa Header ETag & Bỏ cache 304 RevenueCat
dth_del_header = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_del_header.js?v=7.0, timeout=10

# 3. Yêu cầu Full Remote Config US (Bỏ If-None-Match tránh lỗi 304 không có body)
dth_rc_request = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(?:locket-4252a|locket-camera)\/namespaces\/firebase:fetch, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_rc_request.js?v=7.0, requires-body=true, max-size=-1, timeout=10

# 4. Kích hoạt Bộ Lọc Biến Hình AI & AI Camera, Video 60s, Gửi riêng mình, 217+ Captions VIP & All Feature Gates
dth_unlocked = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(?:locket-4252a|locket-camera)\/.+, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_unlocked.js?v=7.0, requires-body=true, max-size=-1, timeout=10

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
