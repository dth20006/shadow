#!name=👑 Locket Gold All-In-One (dth206)
#!desc=Module Locket Gold VIP hoàn hảo nhất bởi dth206 | Kiến trúc độc quyền dth206 v8.1 + Mở khóa Gold Vĩnh Viễn + Toàn diện AI Camera & Bộ Lọc Biến Hình + Video 60s + 217+ Captions VIP + Gửi Riêng Mình (Chỉ mình tôi) + Chặn QC & Tracking + Đồng bộ Locket Profile Gold
#!author=dth206
#!homepage=https://github.com/dth20006/shadow
#!system=ios

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$ header-del If-None-Match

[Script]
# 1. Mở khóa Locket Gold VIP Vĩnh Viễn (RevenueCat)
dth_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_gold.js?v=8.1, requires-body=true, max-size=-1, timeout=10

# 2. Xóa Header ETag & Bỏ cache 304 RevenueCat
dth_del_header = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_del_header.js?v=8.1, timeout=10

# 3. Yêu cầu Full Remote Config US (Bỏ If-None-Match tránh lỗi 304 không có body)
dth_rc_request = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(?:locket-4252a|locket-camera)\/namespaces\/firebase:fetch, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_rc_request.js?v=8.1, requires-body=true, max-size=-1, timeout=10

# 4. Kích hoạt Bộ Lọc Biến Hình AI & AI Camera, Video 60s, Gửi riêng mình, 217+ Captions VIP & All Feature Gates
dth_unlocked = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(?:locket-4252a|locket-camera)\/.+, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_unlocked.js?v=8.1, requires-body=true, max-size=-1, timeout=10

# 5. Giả lập đổi thông tin cá nhân & Huy hiệu Gold (api.locketcamera.com)
dth_badge = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_profile.js?v=8.1, timeout=60

# 6. Đồng bộ huy hiệu Locket Gold Profile trên toàn hệ thống api.locketcamera.com
dth_user = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/dth20006/shadow/main/dth_profile.js?v=8.1, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
